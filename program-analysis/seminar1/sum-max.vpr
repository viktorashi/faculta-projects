method sumMax(x :Int, y: Int ) returns  (sum : Int, max: Int)
ensures sum == x + y
// implicatie logica. 
// super misto
// e practic ... implementarea lol
ensures (x >= y ==> max == x)
ensures (x < y ==> max == y)
{
    max := (x >= y) ? x : y;
    sum := x + y
}

method reconstructSumMax(sum : Int, max: Int) returns (x:Int, y:Int)
requires max >= sum-max
ensures sum == x + y
ensures max == x
ensures max >= y
{
    // nu poti sa stii ordinea, deci alegem asta doar asa
    x:= max
    y:= sum - max
}


method main(){
    var x:Int := -11
    var y:Int := -10
    var sum :Int , max :Int := sumMax(x,y)
    assert sum == x + y
    assert max == -10

    var xMaybe:Int, yMaybe:Int := reconstructSumMax(sum, max)
    assert x == yMaybe
    assert yMaybe == sum - max
}
