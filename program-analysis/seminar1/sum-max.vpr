method sumMax(x :Int, y: Int ) returns  (sum : Int, max: Int)
ensures sum == x + y
// implicatie logica. 
// super misto
// e practic ... implementarea lol
ensures (x >= y ==> max == x)
ensures (x < y ==> max == y)
{
    max := (x >= y) ? x : y;
    sum := x + y
}

method reconstructSumMax(sum : Int, max: Int) returns (x:Int, y:Int)
ensures sum == x + y
ensures (x >= y ==> max == x)
ensures (x < y ==> max == y)


method main(){
    var x:Int := -11
    var y:Int := -10
    var sum :Int , max :Int := sumMax(x,y)
    assert sum == x + y
    assert max == -10

    var xMaybe:Int, yMaybe:Int := reconstructSumMax(sum, max)
    assert x == xMaybe || x == yMaybe
    assert y == xMaybe || y == yMaybe
}
